# Docker Compose environment (development).
# Copy it to .env (ignored by git) and adjust the values: cp .env.example .env
# Symfony defaults live in backend/.env; backend secrets go in backend/.env.local.

# Host port where nginx is published. The API answers at http://localhost:${HTTP_PORT}/api
HTTP_PORT=8080

# MySQL credentials. Compose builds the backend DATABASE_URL from them.
# The test database "${MYSQL_DATABASE}_test" is created automatically the first
# time the mysql-data volume is initialised.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jolo_market
MYSQL_USER=jolo_market
MYSQL_PASSWORD=change-me

# Host user and group ids. The php container runs with them so files created
# through the bind mount (vendor/, var/) stay owned by you. Check with `id -u` and `id -g`.
UID=1000
GID=1000

# Xdebug. INSTALL_XDEBUG is a build argument: rebuild after changing it
# (docker compose build php). XDEBUG_MODE is read at runtime: off, debug, coverage, develop.
INSTALL_XDEBUG=false
XDEBUG_MODE=off

# Auto-deploy (optional, E7). With true, the timer of deploy/ fast-forwards to each new origin/main commit whose CI is
# green, rebuilds the containers, installs dependencies and applies the migrations. Any other value, or leaving it
# out, keeps it off. See the README (Auto-deploy).
AUTO_DEPLOY=false
