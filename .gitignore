# Environment (secrets)
# Root (Docker Compose): only .env.example is committed.
/.env
# Backend follows the Symfony convention: .env and .env.test are committed
# with non-secret defaults; real values go in the ignored local files.
.env.local
.env.local.php
.env.*.local

# Local Docker Compose overrides
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Backend (Symfony / PHP)
/backend/vendor/
/backend/var/
/backend/public/bundles/
/backend/.phpunit.cache/
/backend/.php-cs-fixer.cache
/backend/.deptrac.cache
/backend/phpstan.neon
/backend/phpunit.xml
/backend/coverage/
/backend/infection.log

# Frontend (Node / Vite)
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/playwright-report/
/frontend/test-results/
/frontend/blob-report/
/frontend/.vite/
*.tsbuildinfo

# Backups and dumps
/backups/
*.sql.gz

# Logs
*.log

# AI tooling (machine-specific, auto-generated by gentle-ai)
/.atl/

