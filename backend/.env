# Committed defaults for every environment (PD-11). Never put secrets here.
# Real values and secrets go in .env.local (ignored by git).
# Precedence: real environment variables > .env.$APP_ENV.local > .env.$APP_ENV > .env.local > .env
# In Docker, compose.yaml injects DATABASE_URL, which overrides the value below.

###> symfony/framework-bundle ###
APP_ENV=dev
# Required outside dev and test: set it in .env.local or as a real environment variable.
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://jolo_market:change-me@mysql:3306/jolo_market?serverVersion=9.7.4&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# Base URI used to generate absolute URLs outside HTTP requests (console commands).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> catalog ingestion ###
# Spanish postal code whose prices are imported (PD-5). Required: set it in .env.local.
INSTANCE_POSTAL_CODE=
# Comma-separated slugs of the supermarkets to import and show (PD-24).
# Only Mercadona has an adapter for now: Bonpreu i Esclat and Aldi are deferred (PD-30).
ENABLED_SUPERMARKETS=mercadona,aldi,bonpreu
# User-Agent sent to the supermarkets (PD-26). Operators may add their own contact.
CATALOG_HTTP_USER_AGENT="jolo-market/1.0 (+https://github.com/joeljoanlopez/jolo-market)"
# When catalogs are imported: a cron expression evaluated in Europe/Madrid (PD-27). Daily at 05:00 by default.
INGESTION_SCHEDULE="0 5 * * *"
# Price snapshots older than this many months are deleted, except the latest one of each product (PD-46).
PRICE_HISTORY_RETENTION_MONTHS=24
# When old price snapshots are deleted: a cron expression evaluated in Europe/Madrid (PD-46). Daily at 04:30 by default.
PRICE_HISTORY_PRUNE_SCHEDULE="30 4 * * *"
###< catalog ingestion ###

###> identity ###
# 32 random bytes in base64, used to encrypt TOTP secrets at rest. Required: generate one with
# `php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"` and set it in .env.local.
TOTP_ENCRYPTION_KEY=
###< identity ###
